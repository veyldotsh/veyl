NODE_ENV=production
PUBLIC_ORIGIN=https://veyl.sh
BIND_HOST=127.0.0.1
PORT=4320
VEYL_DATA_DIR=/home/veyl/veyl/data
VEYL_MAINNET_CONFIG=/home/veyl/veyl/current/config/mainnet.json
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# Generate each independently with crypto.randomBytes(32).toString('hex').
# Store the real environment file outside the checkout with permissions 0600.
VEYL_STATE_KEY=
VEYL_GATEWAY_KEY=
VEYL_MAX_TENANTS=100
VEYL_MAX_LOADED_TENANTS=8
# Conservative shared-host pilot; increase only after funded proof measurements.
VEYL_MAX_ACTIVE_RUNTIMES=1
VEYL_MAX_RUNTIME_PROFILES=50
VEYL_RUNTIMES_PER_OWNER=10
VEYL_ACTIVE_JOBS=1
VEYL_MAX_QUEUED_JOBS=100
VEYL_MAX_QUEUED_PER_OWNER=10
VEYL_MAX_DATA_BYTES=2147483648
VEYL_MIN_FREE_BYTES=536870912
VEYL_DAEMON_FIRST_PORT=19000
VEYL_ZKAPI_CLIENTD=/home/veyl/veyl/bin/zkapi-clientd-control
VEYL_ZKAPI_MANIFEST=/home/veyl/veyl/bin/runtime-manifest.json
VEYL_ZKAPI_WALLETD=/home/veyl/veyl/vendor/runtime/bin/zkapi-walletd
VEYL_ZKAPI_PROOF_SETUP=/home/veyl/veyl/vendor/runtime/lib/zkapi-clientd/current/share/zkapi-clientd/proof-setup
VEYL_ENABLE_MAINNET_TRANSACTIONS=false
VEYL_FEE_KEEPER_ENABLED=false
VEYL_ENABLE_SOCIAL_PUBLISHING=false
VEYL_BACKUP_KEY=
VEYL_X_CLIENT_ID=
