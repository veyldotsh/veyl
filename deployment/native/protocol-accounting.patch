+    fn config(directory: &std::path::Path) -> ClientConfig {
+        let signer = CompactSigner::from_seed(&Felt252::from_u64(99));
+        ClientConfig {
+            protocol_version: 2,
+            chain_id: 1,
+            contract_address: Felt252::from_u64(1234),
+            request_charge_cap: 100,
+            policy_charge_cap: 100,
+            policy_enabled: false,
+            server_url: "http://127.0.0.1:1".into(),
+            state_dir: directory.to_string_lossy().into_owned(),
+            trusted_epoch_roots: vec![],
+            proof_mode: ClientProofMode::Groth16 {
+                setup_dir: "unused".into(),
+            },
+            state_signing_key: signer.public_key(),
+            clearance_signing_key: signer.public_key(),
+        }
+    }
