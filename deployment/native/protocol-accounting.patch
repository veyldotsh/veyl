+    #[tokio::test]
+    async fn settlement_recovery_rejects_conflicting_wrapper_and_inner_status_without_writes() {
+        for (outer, finality, inner) in [
+            ("error", "finalized", "ok"),
+            ("ok", "reserved", "ok"),
+            ("ok", "unknown", "ok"),
+            ("ok", "finalized", "pending"),
+            ("ok", "finalized", "finalized"),
+        ] {
+            let (directory, mut wallet, mut response) = fixture(0);
+            response.status = inner.into();
+            let before = std::fs::read(&wallet.journal_path).unwrap();
+            let (server, worker) = recovery_server(&response.client_request_id, json!({
+                "status":outer, "nullifier_status":finality, "request_response":response
+            }));
+            wallet.config.server_url = server;
+            assert!(wallet.recover().await.is_err(), "{outer}/{finality}/{inner}");
+            worker.join().unwrap();
+            assert_eq!(std::fs::read(&wallet.journal_path).unwrap(), before);
+            assert_eq!(wallet.state().unwrap().current_balance, 1000);
+            assert!(wallet.verified_settlement(&response.client_request_id).unwrap().is_none());
+            assert!(!directory.join("settlement_commit.json").exists());
+            std::fs::remove_dir_all(directory).unwrap();
+        }
+    }
