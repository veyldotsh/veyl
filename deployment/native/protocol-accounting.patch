+    fn fixture(charge: u128) -> (PathBuf, Wallet, RequestResponseV2) {
+        let directory =
+            std::env::temp_dir().join(format!("veyl-settlement-{}", uuid::Uuid::new_v4()));
+        let mut wallet = Wallet::new(config(&directory)).unwrap();
+        wallet
+            .confirm_deposit(Felt252::from_u64(42), 7, 1000, 4_000_000_000)
+            .unwrap();
+        let note = wallet.state().unwrap();
+        let nullifier = core::nullifier(&note.secret_s, &note.current_anchor);
+        let anonymous = rerandomize(
+            &CurvePointWire {
+                x: note.current_commitment_x,
+                y: note.current_commitment_y,
+            },
+            &Felt252::ONE,
+        )
+        .unwrap();
+        let next_commitment = server_update(&anonymous, charge, &Felt252::ONE).unwrap();
+        let next_anchor = Felt252::from_u64(123);
+        let signer = CompactSigner::from_seed(&Felt252::from_u64(99));
+        let message = core::state_message(
+            note.protocol_version,
+            note.chain_id,
+            &note.contract_address,
+            &next_commitment.x,
+            &next_commitment.y,
+            &next_anchor,
+        );
+        let payload = json!({"type":"oa_org_ephemeral_lease_settlement"}).to_string();
+        let response = RequestResponseV2 {
+            status: "ok".into(),
+            client_request_id: uuid::Uuid::new_v4().to_string(),
+            request_nullifier: nullifier,
+            response_code: 200,
+            response_hash: canonical_response_hash(payload.as_bytes()),
+            response_payload: payload,
+            charge_applied: charge,
+            next_commitment,
+            next_anchor,
+            blind_delta_srv: Felt252::ONE,
+            next_state_signature: signer.sign(&message),
+            policy_reason_code: None,
+            policy_evidence_hash: None,
+        };
+        PendingRequestJournal::write(
+            &wallet.journal_path,
+            &PendingRequestJournal {
+                exists: true,
+                client_request_id: response.client_request_id.clone(),
+                nullifier,
+                payload_hash: Felt252::ONE,
+                user_rerandomization: Felt252::ONE,
+                created_at_ms: 1,
+                prepared_request: None,
+            },
+        )
+        .unwrap();
+        (directory, wallet, response)
+    }
