index 0000000..34d6cbf
--- /dev/null
+++ b/rust/crates/zkapi-client/src/settlement.rs
@@ -0,0 +1,155 @@
+//! Private write-ahead record for a verified wallet transition and its receipt.
+//! Neither these files nor their prior note state may leave the wallet process.
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use serde::{de::DeserializeOwned, Deserialize, Serialize};
+use zkapi_types::{canonical_response_hash, wire::RequestResponseV2};
+
+use crate::{error::ClientError, journal::PendingRequestJournal, note_state::NoteState};
+
+const MAX_RECORD_BYTES: u64 = 262_144;
+pub(crate) const MAX_RECEIPTS: usize = 10_000;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct SettlementCommit {
+    pub version: u32,
+    pub prior_state: NoteState,
+    pub journal: PendingRequestJournal,
+    pub response: RequestResponseV2,
+    pub charge_cap: u128,
+}
+
+/// Local-only output returned after revalidating the signed wallet transition.
+/// A bridge must filter request payloads to the strict lease authorization
+/// schema before forwarding its quote; arbitrary request payloads are private.
+#[derive(Clone, Serialize)]
+pub struct VerifiedSettlement {
+    pub receipt_id: String,
+    pub client_request_id: String,
+    pub charge_units: String,
+    pub balance_units: String,
+    pub cap_units: String,
+    pub request_payload: Option<String>,
+}
+
+pub(crate) fn invalid() -> ClientError {
+    ClientError::VerificationFailed(
+        "settlement recovery record is inconsistent; preserve wallet files".into(),
+    )
+}
+
+pub(crate) fn equal<T: Serialize>(left: &T, right: &T) -> Result<bool, ClientError> {
+    Ok(serde_json::to_vec(left).map_err(|_| invalid())?
+        == serde_json::to_vec(right).map_err(|_| invalid())?)
+}
+
+pub(crate) fn receipt_path(state_dir: &Path, request_id: &str) -> PathBuf {
+    state_dir.join("verified-settlements").join(format!(
+        "{}.json",
+        canonical_response_hash(request_id.as_bytes()).to_hex()
+    ))
+}
+
+pub(crate) fn read<T: DeserializeOwned>(path: &Path) -> Result<Option<T>, ClientError> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(error) => return Err(error.into()),
+    };
+    if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len() > MAX_RECORD_BYTES
+    {
+        return Err(invalid());
+    }
+    let mut bytes = Vec::new();
+    File::open(path)?
+        .take(MAX_RECORD_BYTES + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > MAX_RECORD_BYTES {
+        return Err(invalid());
+    }
+    serde_json::from_slice(&bytes)
+        .map(Some)
+        .map_err(|_| invalid())
+}
+
+pub(crate) fn sync_directory(path: &Path) -> Result<(), ClientError> {
+    #[cfg(unix)]
+    File::open(path)?.sync_all()?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+
+pub(crate) fn write<T: Serialize>(path: &Path, value: &T) -> Result<(), ClientError> {
+    let bytes = serde_json::to_vec(value).map_err(|_| invalid())?;
+    if bytes.len() as u64 > MAX_RECORD_BYTES {
+        return Err(invalid());
+    }
+    let parent = path.parent().ok_or_else(invalid)?;
+    fs::create_dir_all(parent)?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(parent, fs::Permissions::from_mode(0o700))?;
+    }
+    if let Some(grandparent) = parent.parent() {
+        sync_directory(grandparent)?;
+    }
+    let temp = path.with_extension(format!("{}.tmp", uuid::Uuid::new_v4().simple()));
+    let mut options = OpenOptions::new();
+    options.write(true).create_new(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temp)?;
+    file.write_all(&bytes)?;
+    file.sync_all()?;
+    drop(file);
+    fs::rename(&temp, path)?;
+    sync_directory(parent)
+}
+
+pub(crate) fn clear(path: &Path) -> Result<(), ClientError> {
+    match fs::remove_file(path) {
+        Ok(()) => sync_directory(path.parent().ok_or_else(invalid)?),
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        Err(error) => Err(error.into()),
+    }
+}
+
+pub(crate) fn capacity(state_dir: &Path) -> Result<(), ClientError> {
+    let directory = state_dir.join("verified-settlements");
+    if !directory.exists() {
+        return Ok(());
+    }
+    let mut count = 0;
+    for item in fs::read_dir(directory)? {
+        let item = item?;
+        if item.path().extension().is_some_and(|ext| ext == "json") {
+            count += 1;
+        }
+        if count >= MAX_RECEIPTS {
+            return Err(ClientError::VerificationFailed(
+                "settlement retention is full; no new request is authorized".into(),
+            ));
+        }
+    }
+    Ok(())
+}
+
+// Test-only crash injection is impossible to enable in an installed binary.
+#[cfg(test)]
+thread_local! { pub(crate) static FAIL_AFTER: std::cell::Cell<Option<&'static str>> = const { std::cell::Cell::new(None) }; }
+
+pub(crate) fn checkpoint(_stage: &'static str) -> Result<(), ClientError> {
+    #[cfg(test)]
+    if FAIL_AFTER.with(|failure| failure.get() == Some(_stage)) {
+        return Err(std::io::Error::other("injected settlement crash").into());
+    }
+    Ok(())
+}
