+    #[tokio::test]
+    async fn settlement_recovers_upstream_ok_response_only_after_finalized_wrapper() {
+        for charge in [0, 7] {
+            let (directory, mut wallet, mut response) = fixture(charge);
+            // processor_v2::response_from_record uses `ok` for the signed
+            // response; finality belongs to RecoveryResponseV2's wrapper.
+            response.status = "ok".into();
+            let (server, worker) = recovery_server(&response.client_request_id, json!({
+                "status":"ok", "nullifier_status":"finalized", "request_response":response
+            }));
+            wallet.config.server_url = server;
+            assert!(wallet.recover().await.unwrap().is_some());
+            worker.join().unwrap();
+            let receipt = wallet.verified_settlement(&response.client_request_id).unwrap().unwrap();
+            assert_eq!(receipt.charge_units, charge.to_string());
+            assert_eq!(wallet.state().unwrap().current_balance, 1000 - charge);
+            assert!(!wallet.has_pending_request());
+            assert!(wallet.recover().await.unwrap().is_none());
+            drop(wallet);
+            let restored = Wallet::new(config(&directory)).unwrap();
+            assert_eq!(restored.verified_settlement(&response.client_request_id).unwrap().unwrap().receipt_id, receipt.receipt_id);
+            std::fs::remove_dir_all(directory).unwrap();
+        }
+    }
