+//! Durable application-call bindings. Only the authenticated loopback bridge
+//! can create/read these records. A repeated call never issues another key.
+use std::fs::{self, File, OpenOptions};
+use std::io::{Read, Write};
+use std::path::{Path, PathBuf};
+
+use fs2::FileExt;
+use serde::{Deserialize, Serialize};
+use serde_json::{json, Value};
+use sha2::{Digest, Sha256};
+use zkapi_client::{settlement::VerifiedSettlement, wallet::Wallet};
+use zkapi_types::wire::ApiRequestV2;
+
+use crate::{
+    config::AuthConfig,
+    error::AuthError,
+    oa_native::{self, Quote},
+};
+
+const MAX_CALLS: usize = 10_000;
+const MAX_BYTES: u64 = 16_384;
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Identity {
+    version: u32,
+    journal_id: String,
+    deployment_id: String,
+    chain_id: u64,
+    vault: String,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct Binding {
+    pub version: u32,
+    pub journal_id: String,
+    pub call_id: String,
+    pub session_id: String,
+    pub request_limit_micro_usd: String,
+    pub cap_units: String,
+    pub billing_quote: Quote,
+}
+
+#[derive(Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct CallRecord {
+    version: u32,
+    journal_id: String,
+    call_id: String,
+    request_limit_micro_usd: u64,
+    native_request_id: Option<String>,
+    binding: Option<Binding>,
+}
+
+fn invalid() -> AuthError {
+    AuthError::Wallet(
+        "durable call accounting is unavailable or inconsistent; preserve recovery records".into(),
+    )
+}
+fn conflict() -> AuthError {
+    AuthError::LeasePending(
+        "call ID was already reserved; read its settlement instead of dispatching again".into(),
+    )
+}
+
+pub(crate) fn call_id(value: &str) -> Result<(), AuthError> {
+    let parsed = uuid::Uuid::parse_str(value)
+        .map_err(|_| AuthError::InvalidInput("call_id must be a canonical UUID".into()))?;
+    if parsed.is_nil() || parsed.to_string() != value {
+        return Err(AuthError::InvalidInput(
+            "call_id must be a canonical UUID".into(),
+        ));
+    }
+    Ok(())
+}
+
+fn directory(config: &AuthConfig) -> PathBuf {
+    config.state_dir.join("call-accounting-v1")
+}
+fn call_path(config: &AuthConfig, id: &str) -> Result<PathBuf, AuthError> {
+    call_id(id)?;
+    Ok(directory(config).join("calls").join(format!("{id}.json")))
+}
+fn sync(path: &Path) -> Result<(), AuthError> {
+    #[cfg(unix)]
+    File::open(path)
+        .and_then(|file| file.sync_all())
+        .map_err(|_| invalid())?;
+    #[cfg(not(unix))]
+    let _ = path;
+    Ok(())
+}
+fn read<T: serde::de::DeserializeOwned>(path: &Path) -> Result<Option<T>, AuthError> {
+    let metadata = match fs::symlink_metadata(path) {
+        Ok(value) => value,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => return Ok(None),
+        Err(_) => return Err(invalid()),
+    };
+    if !metadata.is_file() || metadata.file_type().is_symlink() || metadata.len() > MAX_BYTES {
+        return Err(invalid());
+    }
+    let mut bytes = vec![];
+    File::open(path)
+        .map_err(|_| invalid())?
+        .take(MAX_BYTES + 1)
+        .read_to_end(&mut bytes)
+        .map_err(|_| invalid())?;
+    if bytes.len() as u64 > MAX_BYTES {
+        return Err(invalid());
+    }
+    serde_json::from_slice(&bytes)
+        .map(Some)
+        .map_err(|_| invalid())
+}
+fn write<T: Serialize>(path: &Path, value: &T, exclusive: bool) -> Result<(), AuthError> {
+    let bytes = serde_json::to_vec(value).map_err(|_| invalid())?;
+    if bytes.len() as u64 > MAX_BYTES {
+        return Err(invalid());
+    }
+    let parent = path.parent().ok_or_else(invalid)?;
+    fs::create_dir_all(parent).map_err(|_| invalid())?;
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::PermissionsExt;
+        fs::set_permissions(parent, fs::Permissions::from_mode(0o700)).map_err(|_| invalid())?;
+    }
+    if let Some(above) = parent.parent() {
+        sync(above)?;
+    }
+    let temp = path.with_extension(format!("{}.tmp", uuid::Uuid::new_v4().simple()));
+    let mut options = OpenOptions::new();
+    options.create_new(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let mut file = options.open(&temp).map_err(|_| invalid())?;
+    file.write_all(&bytes)
+        .and_then(|_| file.sync_all())
+        .map_err(|_| invalid())?;
+    drop(file);
+    if exclusive {
+        match fs::hard_link(&temp, path) {
+            Ok(()) => {}
+            Err(error) => {
+                let _ = fs::remove_file(&temp);
+                return Err(if error.kind() == std::io::ErrorKind::AlreadyExists {
+                    conflict()
+                } else {
+                    invalid()
+                });
+            }
+        }
+        fs::remove_file(temp).map_err(|_| invalid())?;
+    } else {
+        fs::rename(temp, path).map_err(|_| invalid())?;
+    }
+    sync(parent)
+}
+
+pub(crate) fn initialize(config: &AuthConfig) -> Result<(), AuthError> {
+    let base = directory(config);
+    let path = base.join("identity.json");
+    if read::<Identity>(&path)?.is_none() {
+        // Never silently replace a missing identity while old calls remain.
+        if base.join("calls").exists() {
+            return Err(invalid());
+        }
+        let identity = Identity {
+            version: 1,
+            journal_id: uuid::Uuid::new_v4().simple().to_string(),
+            deployment_id: config.deployment_id.clone(),
+            chain_id: config.chain_id,
+            vault: config.contract_address.to_hex(),
+        };
+        match write(&path, &identity, true) {
+            Ok(()) => {}
+            Err(AuthError::LeasePending(_)) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    identity(config).map(|_| ())
+}
+
+fn identity(config: &AuthConfig) -> Result<Identity, AuthError> {
+    let saved: Identity = read(&directory(config).join("identity.json"))?.ok_or_else(invalid)?;
+    if saved.version != 1
+        || saved.journal_id.len() != 32
+        || !saved.journal_id.bytes().all(|c| c.is_ascii_hexdigit())
+        || saved.deployment_id != config.deployment_id
+        || saved.chain_id != config.chain_id
+        || saved.vault != config.contract_address.to_hex()
+    {
+        return Err(invalid());
+    }
+    Ok(saved)
+}
+
+pub(crate) fn status(config: &AuthConfig) -> Result<Value, AuthError> {
+    let saved = identity(config)?;
+    Ok(json!({"version":1,"journal_id":saved.journal_id}))
+}
+
+pub(crate) fn reserve(config: &AuthConfig, id: &str, limit: u64) -> Result<(), AuthError> {
+    let _lock = lock(config)?;
+    resume_binding(config)?;
+    call_id(id)?;
+    let saved = identity(config)?;
+    let calls = directory(config).join("calls");
+    if calls.exists() {
+        let count = fs::read_dir(calls)
+            .map_err(|_| invalid())?
+            .take(MAX_CALLS + 1)
+            .count();
+        if count >= MAX_CALLS {
+            return Err(AuthError::Wallet(
+                "call accounting retention is full; no new request is authorized".into(),
+            ));
+        }
+    }
+    let record = CallRecord {
+        version: 1,
+        journal_id: saved.journal_id,
+        call_id: id.to_owned(),
+        request_limit_micro_usd: limit,
+        native_request_id: None,
+        binding: None,
+    };
+    write(&call_path(config, id)?, &record, true)
+}
+
+fn record(config: &AuthConfig, id: &str) -> Result<Option<CallRecord>, AuthError> {
+    let saved = identity(config)?;
+    let Some(record): Option<CallRecord> = read(&call_path(config, id)?)? else {
+        return Ok(None);
+    };
+    validate_record(config, id, &record, &saved)?;
+    Ok(Some(record))
+}
+
+fn validate_record(
+    config: &AuthConfig,
+    id: &str,
+    record: &CallRecord,
+    saved: &Identity,
+) -> Result<(), AuthError> {
+    if record.version != 1
+        || record.journal_id != saved.journal_id
+        || record.call_id != id
+        || ![1_000_000, 2_000_000, 3_000_000, 4_500_000, 6_000_000]
+            .contains(&record.request_limit_micro_usd)
+    {
+        return Err(invalid());
+    }
+    match (&record.binding, &record.native_request_id) {
+        (None, None) => {}
+        (Some(binding), Some(native)) => {
+            binding.billing_quote.validate(config, true)?;
+            if binding.version != 1
+                || binding.journal_id != record.journal_id
+                || binding.call_id != id
+                || binding.session_id != format!("{:x}", Sha256::digest(native.as_bytes()))
+                || binding.request_limit_micro_usd != record.request_limit_micro_usd.to_string()
+                || binding.cap_units
+                    != binding
+                        .billing_quote
+                        .budget_units(record.request_limit_micro_usd.into())?
+                        .max(config.request_charge_cap)
+                        .to_string()
+            {
+                return Err(invalid());
+            }
+        }
+        _ => return Err(invalid()),
+    }
+    Ok(())
+}
+
+fn lock(config: &AuthConfig) -> Result<File, AuthError> {
+    identity(config)?;
+    let mut options = OpenOptions::new();
+    options.create(true).read(true).write(true);
+    #[cfg(unix)]
+    {
+        use std::os::unix::fs::OpenOptionsExt;
+        options.mode(0o600);
+    }
+    let file = options
+        .open(directory(config).join("binding.lock"))
+        .map_err(|_| invalid())?;
+    file.lock_exclusive().map_err(|_| invalid())?;
+    Ok(file)
+}
+
+fn owner_path(config: &AuthConfig, native: &str) -> PathBuf {
+    directory(config)
+        .join("owners")
+        .join(format!("{:x}.json", Sha256::digest(native.as_bytes())))
+}
+
+// A write-ahead commit links both indexes before remote submission. Recovery
+// rolls it forward under a process-shared lock; no request ID can belong to two
+// application calls, even if a process dies between the two durable writes.
+fn resume_binding(config: &AuthConfig) -> Result<(), AuthError> {
+    let path = directory(config).join("binding-commit.json");
+    let Some(saved): Option<CallRecord> = read(&path)? else {
+        return Ok(());
+    };
+    let identity = identity(config)?;
+    call_id(&saved.call_id)?;
+    validate_record(config, &saved.call_id, &saved, &identity)?;
+    let native = saved.native_request_id.as_deref().ok_or_else(invalid)?;
+    if saved.binding.is_none() {
+        return Err(invalid());
+    }
+    let owner = owner_path(config, native);
+    if let Some(previous) = read::<CallRecord>(&owner)? {
+        if serde_json::to_vec(&previous).map_err(|_| invalid())?
+            != serde_json::to_vec(&saved).map_err(|_| invalid())?
+        {
+            return Err(invalid());
+        }
+    } else {
+        write(&owner, &saved, true)?;
+    }
+    checkpoint("owner-saved")?;
+    let previous = record(config, &saved.call_id)?.ok_or_else(invalid)?;
+    if previous.request_limit_micro_usd != saved.request_limit_micro_usd {
+        return Err(invalid());
+    }
+    if previous.binding.is_some()
+        && serde_json::to_vec(&previous).map_err(|_| invalid())?
+            != serde_json::to_vec(&saved).map_err(|_| invalid())?
+    {
+        return Err(invalid());
+    }
+    write(&call_path(config, &saved.call_id)?, &saved, false)?;
+    checkpoint("call-saved")?;
+    fs::remove_file(&path).map_err(|_| invalid())?;
+    sync(&directory(config))?;
+    checkpoint("binding-cleared")
+}
+
+pub(crate) fn binding_for_request(
+    config: &AuthConfig,
+    id: &str,
+    native: &str,
+) -> Result<Binding, AuthError> {
+    let _lock = lock(config)?;
+    resume_binding(config)?;
+    let saved = record(config, id)?.ok_or_else(invalid)?;
+    if saved.native_request_id.as_deref() != Some(native) {
+        return Err(conflict());
+    }
+    let owner: CallRecord = read(&owner_path(config, native))?.ok_or_else(invalid)?;
+    if serde_json::to_vec(&saved).map_err(|_| invalid())?
+        != serde_json::to_vec(&owner).map_err(|_| invalid())?
+    {
+        return Err(invalid());
+    }
+    saved.binding.ok_or_else(invalid)
+}
+
+pub(crate) fn require_unbound_request(config: &AuthConfig, native: &str) -> Result<(), AuthError> {
+    let _lock = lock(config)?;
+    resume_binding(config)?;
+    if read::<CallRecord>(&owner_path(config, native))?.is_some() {
+        return Err(conflict());
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+thread_local! { static FAIL_AFTER: std::cell::Cell<Option<&'static str>> = const { std::cell::Cell::new(None) }; }
+fn checkpoint(_stage: &str) -> Result<(), AuthError> {
+    #[cfg(test)]
+    if FAIL_AFTER.with(|value| value.get() == Some(_stage)) {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+pub(crate) fn bind(
+    config: &AuthConfig,
+    id: &str,
+    native_id: &str,
+    request: &ApiRequestV2,
+) -> Result<Binding, AuthError> {
+    let _lock = lock(config)?;
+    resume_binding(config)?;
+    let mut saved = record(config, id)?.ok_or_else(invalid)?;
+    if saved.binding.is_some() || saved.native_request_id.is_some() {
+        return Err(conflict());
+    }
+    if request.client_request_id != native_id {
+        return Err(invalid());
+    }
+    if read::<CallRecord>(&owner_path(config, native_id))?.is_some() {
+        return Err(conflict());
+    }
+    let quote = oa_native::saved_quote(config, &request.payload)?.ok_or_else(invalid)?;
+    let expected = quote
+        .budget_units(saved.request_limit_micro_usd.into())?
+        .max(config.request_charge_cap);
+    if expected != request.public_inputs.solvency_bound {
+        return Err(invalid());
+    }
+    let binding = Binding {
+        version: 1,
+        journal_id: saved.journal_id.clone(),
+        call_id: id.to_owned(),
+        session_id: format!("{:x}", Sha256::digest(native_id.as_bytes())),
+        request_limit_micro_usd: saved.request_limit_micro_usd.to_string(),
+        cap_units: expected.to_string(),
+        billing_quote: quote,
+    };
+    saved.native_request_id = Some(native_id.to_owned());
+    saved.binding = Some(binding.clone());
+    write(
+        &directory(config).join("binding-commit.json"),
+        &saved,
+        false,
+    )?;
+    checkpoint("binding-staged")?;
+    resume_binding(config)?;
+    Ok(binding)
+}
+
+fn receipt(
+    binding: &Binding,
+    verified: VerifiedSettlement,
+    config: &AuthConfig,
+) -> Result<Value, AuthError> {
+    let quote = oa_native::saved_quote(
+        config,
+        verified.request_payload.as_deref().ok_or_else(invalid)?,
+    )?
+    .ok_or_else(invalid)?;
+    if quote != binding.billing_quote
+        || verified.cap_units != binding.cap_units
+        || format!(
+            "{:x}",
+            Sha256::digest(verified.client_request_id.as_bytes())
+        ) != binding.session_id
+    {
+        return Err(invalid());
+    }
+    Ok(
+        json!({"receipt_id":verified.receipt_id,"charge_units":verified.charge_units,"balance_units":verified.balance_units}),
+    )
+}
+
+pub(crate) fn snapshot(
+    config: &AuthConfig,
+    id: &str,
+    wallet: &Wallet,
+) -> Result<Option<Value>, AuthError> {
+    let _lock = lock(config)?;
+    resume_binding(config)?;
+    let Some(saved) = record(config, id)? else {
+        return Ok(None);
+    };
+    let mut result =
+        json!({"version":1,"journal_id":saved.journal_id,"call_id":id,"status":"reserved"});
+    if let Some(binding) = saved.binding {
+        result["status"] = json!("bound");
+        result["binding"] = serde_json::to_value(&binding).map_err(|_| invalid())?;
+        if let Some(verified) = wallet
+            .verified_settlement(saved.native_request_id.as_deref().ok_or_else(invalid)?)
+            .map_err(|_| invalid())?
+        {
+            result["receipt"] = receipt(&binding, verified, config)?;
+            result["status"] = json!("settled");
+        }
+    }
+    Ok(Some(result))
+}
