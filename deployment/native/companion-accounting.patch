+    #[test]
+    fn call_accounting_preissuance_crashes_restore_binding_and_never_reassign_native_request() {
+        for stage in [
+            "binding-staged",
+            "owner-saved",
+            "call-saved",
+            "binding-cleared",
+        ] {
+            let directory = tempfile::tempdir().unwrap();
+            let (config, mut wallet, request, response) = fixture(directory.path());
+            let id = uuid::Uuid::new_v4().to_string();
+            reserve(&config, &id, 1_000_000).unwrap();
+            FAIL_AFTER.with(|fail| fail.set(Some(stage)));
+            assert!(
+                bind(&config, &id, &request.client_request_id, &request).is_err(),
+                "{stage}"
+            );
+            FAIL_AFTER.with(|fail| fail.set(None));
+            // A new process loads only disk state. Recovery finishes both
+            // indexes before exposing the bound call or allowing a new bind.
+            initialize(&config).unwrap();
+            assert_eq!(
+                snapshot(&config, &id, &wallet).unwrap().unwrap()["status"],
+                "bound",
+                "{stage}"
+            );
+            assert!(binding_for_request(&config, &id, &request.client_request_id).is_ok());
+            assert!(require_unbound_request(&config, &request.client_request_id).is_err());
+            let other = uuid::Uuid::new_v4().to_string();
+            reserve(&config, &other, 1_000_000).unwrap();
+            assert!(bind(&config, &other, &request.client_request_id, &request).is_err());
+            assert!(bind(&config, &id, &request.client_request_id, &request).is_err());
+            // A server-accepted request whose reply was lost still resolves
+            // to the original job after its genuine signed response arrives.
+            wallet.complete_pending_response(&response).unwrap();
+            let result = snapshot(&config, &id, &wallet).unwrap().unwrap();
+            assert_eq!(result["status"], "settled");
+            assert_eq!(result["receipt"]["charge_units"], "7");
+            assert_eq!(
+                snapshot(&config, &other, &wallet).unwrap().unwrap()["status"],
+                "reserved"
+            );
+        }
+    }
+
+    #[test]
+    fn call_accounting_parallel_reservation_has_one_winner_and_never_rebinds() {
+        let directory = tempfile::tempdir().unwrap();
+        let (config, wallet, _, _) = fixture(directory.path());
+        let id = uuid::Uuid::new_v4().to_string();
+        let results = std::thread::scope(|scope| {
+            let first = scope.spawn(|| reserve(&config, &id, 1_000_000));
+            let second = scope.spawn(|| reserve(&config, &id, 1_000_000));
+            [
+                first.join().unwrap().is_ok(),
+                second.join().unwrap().is_ok(),
+            ]
+        });
+        assert_eq!(results.into_iter().filter(|ok| *ok).count(), 1);
+        assert!(reserve(&config, &id, 2_000_000).is_err());
+        assert_eq!(
+            snapshot(&config, &id, &wallet).unwrap().unwrap()["status"],
+            "reserved"
+        );
+    }
+}
