+        let id = uuid::Uuid::new_v4().to_string();
+        let identity = status(&config).unwrap();
+        reserve(&config, &id, 1_000_000).unwrap();
+        assert_eq!(
+            snapshot(&config, &id, &wallet).unwrap().unwrap()["status"],
+            "reserved"
+        );
+        assert!(reserve(&config, &id, 1_000_000).is_err());
+        let binding = bind(&config, &id, &request.client_request_id, &request).unwrap();
+        assert!(bind(&config, &id, &request.client_request_id, &request).is_err());
+        assert_eq!(
+            snapshot(&config, &id, &wallet).unwrap().unwrap()["status"],
+            "bound"
+        );
+        wallet.complete_pending_response(&response).unwrap();
+        initialize(&config).unwrap();
+        assert_eq!(status(&config).unwrap(), identity);
+        let settled = snapshot(&config, &id, &wallet).unwrap().unwrap();
+        assert_eq!(settled["status"], "settled");
+        assert_eq!(settled["binding"], serde_json::to_value(binding).unwrap());
+        assert_eq!(settled["receipt"]["charge_units"], "7");
+        assert_eq!(settled["receipt"]["balance_units"], "999993");
+        let text = settled.to_string();
+        for secret in [
+            request.client_request_id.as_str(),
+            "secret_s",
+            "balance_blinding",
+            "next_state_signature",
+            "proof",
+        ] {
+            assert!(!text.contains(secret));
+        }
+        assert_eq!(snapshot(&config, &id, &wallet).unwrap().unwrap(), settled);
+    }
