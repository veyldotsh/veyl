+        let id = uuid::Uuid::new_v4().to_string();
+        reserve(&config, &id, 1_000_000).unwrap();
+        bind(&config, &id, &request.client_request_id, &request).unwrap();
+        let mut changed: Value = serde_json::from_str(&response.response_payload).unwrap();
+        changed["billing_quote"]["answer"] = json!("300000000000");
+        response.response_payload = changed.to_string();
+        response.response_hash = canonical_response_hash(response.response_payload.as_bytes());
+        assert!(wallet.complete_pending_response(&response).is_err());
+        assert_eq!(
