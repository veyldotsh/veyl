+					t.Fatalf("exact migration failed: %v", err)
+				}
+				if _, err = writeDeploymentManifest(dir, current); err != nil {
+					t.Fatal("restart failed", err)
+				}
+			} else if err == nil || !bytes.Equal(before, after) {
+				t.Fatal("unknown source accepted or overwritten")
+			}
+			if !bytes.Equal(saved, sentinel) {
+				t.Fatal("wallet/request changed")
+			}
+		})
+	}
+	for _, target := range [][]byte{append(append([]byte(nil), current...), '\n'), old} {
+		if isMainnetIssuerMigration(old, target) {
+			t.Fatal("unreviewed target admitted")
+		}
+	}
+	_, sepolia, _ := pinnedDeployment("sepolia")
+	if isMainnetIssuerMigration(sepolia, current) {
+		t.Fatal("cross-network migration accepted")
+	}
+}
