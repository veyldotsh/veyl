+func TestCompanionDiagnosticsKeepOnlyFixedEnums(t *testing.T) {
+	for _, tc := range []struct{ code, message, want string }{
+		{"key_verification_failed", "OA key verification failed: verifier response binding mismatch", "verifier_binding_mismatch"},
+		{"key_verification_failed", "OA key verification failed: station is banned", "verifier_station_banned"},
+		{"key_verification_failed", "OA key verification failed: verifier did not approve this station and key", "verifier_response_rejected"},
+		{"key_verification_failed", "secret private-key prompt", "key_verification_failed"},
+		{"wallet_error", "wallet error: cannot sync lease reservation parent", "lease_reservation_failed"},
+		{"wallet_error", "secret private-key prompt", "wallet_error"},
+		{"secret private-key", "secret prompt", "companion_request_failed"},
+		{"other", "OA key verification failed: station is banned", "companion_request_failed"},
+	} {
+		t.Run(tc.want+tc.code, func(t *testing.T) {
+			calls := 0
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				calls++
+				if r.Method != http.MethodGet {
+					t.Error("diagnostic fixture retried with a write")
+				}
+				w.WriteHeader(502)
+				_ = json.NewEncoder(w).Encode(map[string]any{"error": map[string]string{"code": tc.code, "message": tc.message}})
+			}))
+			defer server.Close()
+			client, err := New(Config{ClientURL: server.URL, BridgeToken: testBridgeToken, HTTPClient: http.DefaultClient})
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = client.request(context.Background(), http.MethodGet, "/diagnostic-fixture", nil)
+			failure, ok := err.(*Error)
+			if !ok || failure.Code != tc.want || failure.DiagnosticCode() != tc.want || calls != 1 {
+				t.Fatalf("wrong diagnostic: %v calls %d", err, calls)
+			}
+			if strings.Contains(failure.Error(), "secret") || strings.Contains(failure.Error(), "prompt") {
+				t.Fatal("private message leaked")
+			}
+		})
+	}
+}
