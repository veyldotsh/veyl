index 0000000..d690869
--- /dev/null
+++ b/zkapi-clientd/internal/config/verifier_migration_test.go
@@ -0,0 +1,68 @@
+package config
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReviewedMainnetVerifierMigrationPreservesSavedState(t *testing.T) {
+	for _, tc := range []struct{ network, saved, expected string }{
+		{"mainnet", sepoliaVerifierURL, mainnetVerifierURL},
+		{"mainnet", sepoliaVerifierURL + "/", mainnetVerifierURL},
+		{"mainnet", mainnetVerifierURL, mainnetVerifierURL},
+		{"mainnet", "https://explicit.example", "https://explicit.example"},
+		{"sepolia", sepoliaVerifierURL, sepoliaVerifierURL},
+	} {
+		t.Run(tc.network+tc.saved, func(t *testing.T) {
+			c, _ := Default()
+			c.ZKAPI.Network = tc.network
+			c.VerifierURL = tc.saved
+			dir := filepath.Join(t.TempDir(), "profile")
+			if err := Init(dir, c); err != nil {
+				t.Fatal(err)
+			}
+			cfg := filepath.Join(dir, "config.json")
+			before, _ := os.ReadFile(cfg)
+			pending := filepath.Join(dir, "pending_journal.json")
+			sentinel := []byte("preserved synthetic pending request")
+			if err := os.WriteFile(pending, sentinel, 0600); err != nil {
+				t.Fatal(err)
+			}
+			got, err := readConfig(dir)
+			if err != nil || got.VerifierURL != tc.expected {
+				t.Fatalf("wrong migration: %v", err)
+			}
+			got.VerifierURL = c.VerifierURL
+			if got != c {
+				t.Fatal("migration changed another field")
+			}
+			after, _ := os.ReadFile(cfg)
+			state, _ := os.ReadFile(pending)
+			if !bytes.Equal(before, after) || !bytes.Equal(state, sentinel) {
+				t.Fatal("migration rewrote saved state")
+			}
+		})
+	}
+}
+
+func TestNetworkVerifierDefaultsPreserveExplicitOverrides(t *testing.T) {
+	c, _ := Default()
+	if c.VerifierURL != mainnetVerifierURL {
+		t.Fatal("wrong mainnet default")
+	}
+	c = SelectNetwork(c, "sepolia")
+	if c.VerifierURL != sepoliaVerifierURL {
+		t.Fatal("wrong Sepolia default")
+	}
+	c = SelectNetwork(c, "mainnet")
+	if c.VerifierURL != mainnetVerifierURL {
+		t.Fatal("wrong mainnet selection")
+	}
+	c.VerifierURL = "https://explicit.example"
+	c = SelectNetwork(c, "sepolia")
+	if c.VerifierURL != "https://explicit.example" || DefaultVerifierURL("unknown") != "" {
+		t.Fatal("explicit trust override changed")
+	}
+}
