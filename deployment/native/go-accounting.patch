new file mode 100644
index 0000000..f040f4b
--- /dev/null
+++ b/zkapi-clientd/internal/accounting/context.go
@@ -0,0 +1,33 @@
+// Package accounting carries local-only durable admission metadata. It never
+// becomes provider JSON or a provider request header.
+package accounting
+
+import (
+	"context"
+	"regexp"
+)
+
+type Admission struct {
+	CallID           string
+	JournalID        string
+	ReservedMicroUSD uint64
+}
+type contextKey struct{}
+
+var uuidPattern = regexp.MustCompile(`^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$`)
+var journalPattern = regexp.MustCompile(`^[0-9a-f]{32}$`)
+
+func ValidCallID(v string) bool {
+	return uuidPattern.MatchString(v) && v != "00000000-0000-0000-0000-000000000000"
+}
+func ValidJournalID(v string) bool { return journalPattern.MatchString(v) }
+func (a Admission) Valid() bool {
+	return ValidCallID(a.CallID) && ValidJournalID(a.JournalID) && a.ReservedMicroUSD > 0 && a.ReservedMicroUSD <= 1_000_000_000
+}
+func WithAdmission(ctx context.Context, a Admission) context.Context {
+	return context.WithValue(ctx, contextKey{}, a)
+}
+func FromContext(ctx context.Context) (Admission, bool) {
+	a, ok := ctx.Value(contextKey{}).(Admission)
+	return a, ok
+}
