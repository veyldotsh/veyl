+func TestMainnetIssuerMigrationPinsOnlyReviewedExactManifestPair(t *testing.T) {
+	identity, current, err := pinnedDeployment("mainnet")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if identity.Privacy.VerifierURL != "https://verifier-production-20260917.openanonymity.ai" || identity.Privacy.IssuerURL != "https://org-live.openanonymity.ai" {
+		t.Fatal("wrong production trust pins")
+	}
+	old := bytes.Replace(current, []byte("https://org-live.openanonymity.ai"), []byte("https://org-staging.openanonymity.ai"), 1)
+	old = bytes.Replace(old, []byte("https://verifier-production-20260917.openanonymity.ai"), []byte("https://verifier2.openanonymity.ai"), 1)
+	hash := sha256.Sum256(old)
+	if hex.EncodeToString(hash[:]) != previousMainnetManifestSHA256 {
+		t.Fatal("old manifest does not match reviewed exact hash")
+	}
+	for name, change := range map[string]func([]byte) []byte{
+		"exact": func(b []byte) []byte { return b },
+		"vault": func(b []byte) []byte {
+			return bytes.Replace(b, []byte(identity.Contract), []byte("0x1111111111111111111111111111111111111111"), 1)
+		},
+		"verifier": func(b []byte) []byte {
+			return bytes.Replace(b, []byte("https://verifier2.openanonymity.ai"), []byte("https://untrusted.example"), 1)
+		},
+		"issuer": func(b []byte) []byte {
+			return bytes.Replace(b, []byte("https://org-staging.openanonymity.ai"), []byte("https://untrusted.example"), 1)
+		},
+		"partial": func(b []byte) []byte {
+			return bytes.Replace(b, []byte("https://org-staging.openanonymity.ai"), []byte("https://org-live.openanonymity.ai"), 1)
+		},
+		"extra": func(b []byte) []byte { return append(b, '\n') },
+	} {
+		t.Run(name, func(t *testing.T) {
+			dir := t.TempDir()
+			file := filepath.Join(dir, "deployment-manifest.json")
+			before := change(append([]byte(nil), old...))
+			if err := os.WriteFile(file, before, 0600); err != nil {
+				t.Fatal(err)
+			}
+			state := filepath.Join(dir, "pending_journal.json")
+			sentinel := []byte("existing note/request/signatures unchanged")
+			if err := os.WriteFile(state, sentinel, 0600); err != nil {
+				t.Fatal(err)
+			}
+			_, err := writeDeploymentManifest(dir, current)
+			after, _ := os.ReadFile(file)
+			saved, _ := os.ReadFile(state)
+			if name == "exact" {
