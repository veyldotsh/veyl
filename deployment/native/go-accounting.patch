+)
+
+type accountingBackend struct {
+	fakeBackend
+	reads int
+}
+
+func (b *accountingBackend) Accounting(context.Context) (json.RawMessage, error) {
+	b.reads++
+	return json.RawMessage(`{"version":1,"journal_id":"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"}`), nil
+}
+func (b *accountingBackend) CallSettlement(context.Context, string) (json.RawMessage, error) {
+	b.reads++
+	return json.RawMessage(`{"status":"reserved"}`), nil
+}
+func TestAccountingLookupsAlwaysRequireBearerAndRejectBrowserOrArbitraryPaths(t *testing.T) {
+	for _, tc := range []struct {
+		path, key, origin string
+		want              int
+	}{{"/v1/accounting", "", "", 401}, {"/v1/accounting", testKey, "https://example.com", 403}, {"/v1/accounting", testKey, "", 200}, {"/v1/call-settlements/a0000000-0000-4000-8000-000000000001", testKey, "", 200}, {"/v1/call-settlements/not-uuid", testKey, "", 400}, {"/v1/accounting?secret=x", testKey, "", 404}} {
+		t.Run(tc.path+tc.key+tc.origin, func(t *testing.T) {
+			b := &accountingBackend{}
+			api, _ := New(b, testKey, 1)
+			r := httptest.NewRequest("GET", tc.path, nil)
+			r.Header.Set("Authorization", "Bearer "+tc.key)
+			r.Header.Set("Origin", tc.origin)
+			w := httptest.NewRecorder()
+			api.ServeHTTP(w, r)
+			if w.Code != tc.want {
+				t.Fatalf("got%d want%d", w.Code, tc.want)
+			}
+			if w.Header().Get("Cache-Control") != "no-store" {
+				t.Fatal("cacheable receipt")
+			}
+			if tc.want != 200 && b.reads != 0 {
+				t.Fatal("unauthorized lookup")
+			}
+		})
+	}
+}
+func TestTrackedHeadersAreAuthenticatedCompleteAndLocalOnly(t *testing.T) {
+	for _, kind := range []string{"valid", "no bearer", "partial", "noncanonical", "duplicate"} {
+		t.Run(kind, func(t *testing.T) {
+			calls := 0
+			b := &fakeBackend{complete: func(ctx context.Context, body json.RawMessage) (*http.Response, error) {
+				calls++
+				a, ok := accounting.FromContext(ctx)
+				if !ok || !a.Valid() || a.ReservedMicroUSD != 1001000 {
+					t.Error("admission absent")
+				}
+				if strings.Contains(string(body), "journal") {
+					t.Error("transport leaked into body")
+				}
+				return &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(strings.NewReader(`{"choices":[]}`))}, nil
+			}}
+			api, _ := New(b, testKey, 1)
+			r := httptest.NewRequest("POST", "/v1/chat/completions", strings.NewReader(`{"model":"m","messages":[{"role":"user","content":"test"}]}`))
+			r.Header.Set("Content-Type", "application/json")
+			r.Header.Set("Authorization", "Bearer "+testKey)
+			r.Header.Set("X-Veyl-Call-Id", "a0000000-0000-4000-8000-000000000001")
+			r.Header.Set("X-Veyl-Journal-Id", strings.Repeat("a", 32))
+			r.Header.Set("X-Veyl-Reserved-Micro-Usd", "1001000")
+			switch kind {
+			case "no bearer":
+				r.Header.Del("Authorization")
+			case "partial":
+				r.Header.Del("X-Veyl-Journal-Id")
+			case "noncanonical":
+				r.Header.Set("X-Veyl-Reserved-Micro-Usd", "01001000")
+			case "duplicate":
+				r.Header.Add("X-Veyl-Call-Id", "a0000000-0000-4000-8000-000000000002")
+			}
+			w := httptest.NewRecorder()
+			api.ServeHTTP(w, r)
+			if kind == "valid" {
+				if calls != 1 || w.Code != 200 {
+					t.Fatalf("valid admission blocked%d", w.Code)
+				}
+			} else if calls != 0 || w.Code < 400 {
+				t.Fatal("invalid admission dispatched")
+			}
+		})
+	}
+}
