+func TestTrackedWaitsForPriorSignedRecoveryBeforeOneLeaseAuthorization(t *testing.T) {
+	var reads, leases, retirements, calls int
+	upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls++; _, _ = io.WriteString(w, `{"choices":[]}`) }))
+	defer upstream.Close()
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/oa/v1/accounting":
+			_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+		case "/wallet/settle":
+			retirements++
+			w.WriteHeader(409)
+			_, _ = io.WriteString(w, `{"code":"pending_request"}`)
+		case "/wallet/status":
+			reads++
+			_ = json.NewEncoder(w).Encode(map[string]any{"has_note": true, "pending_request": reads < 3})
+		case "/oa/v1/lease":
+			leases++
+			if reads < 3 {
+				t.Error("lease authorized before settlement")
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"api_key": "next-round-key", "base_url": upstream.URL, "expires_at": time.Now().Unix() + 60, "verified": true, "verification_status": "verified", "accounting": testBinding()})
+		default:
+			t.Errorf("unexpected path%s", r.URL.Path)
+		}
+	}, upstream)
+	client.leaseGroup = &leaseGroup{serial: 1, until: time.Now()}
+	client.keySerial = 1
+	client.settlementPoll = time.Millisecond
+	response, err := client.Complete(trackedContext(1001000), json.RawMessage(`{"model":"example/model"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, response.Body)
+	_ = response.Body.Close()
+	if reads != 3 || retirements != 1 || leases != 1 || calls != 1 {
+		t.Fatalf("reads%d retire%d leases%d calls%d", reads, retirements, leases, calls)
+	}
+}
