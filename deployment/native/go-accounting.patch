index 0000000..4dbafa2
--- /dev/null
+++ b/zkapi-clientd/internal/zkapi/call_accounting_test.go
@@ -0,0 +1,255 @@
+package zkapi
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/ethereum/zkapi/zkapi-clientd/internal/accounting"
+)
+
+const trackedCall = "a0000000-0000-4000-8000-000000000001"
+const trackedJournal = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+
+func testBinding() *CallBinding {
+	now := uint64(time.Now().Unix())
+	return &CallBinding{Version: 1, JournalID: trackedJournal, CallID: trackedCall, SessionID: strings.Repeat("b", 64), RequestLimitMicroUSD: "1000000", CapUnits: "333334", BillingQuote: NativeUSDQuote{Asset: "native_eth", UnitsPerETH: 1_000_000_000, ChainID: 1, FeedAddress: "0x5f4ec3df9cbd43714fe2740f5e3616155c5b8419", RoundID: "123", Answer: "300000000000", Decimals: 8, UpdatedAt: now - 100, ExpiresAt: now + 4400}}
+}
+func trackedContext(reserved uint64) context.Context {
+	return accounting.WithAdmission(context.Background(), accounting.Admission{CallID: trackedCall, JournalID: trackedJournal, ReservedMicroUSD: reserved})
+}
+func TestTrackedLeaseReservesOneSessionAndNeverLeaksAdmissionToProvider(t *testing.T) {
+	var calls, leases, settlements int
+	upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls++
+		for name := range r.Header {
+			if strings.Contains(strings.ToLower(name), "veyl") {
+				t.Error("admission header leaked")
+			}
+		}
+		_, _ = io.WriteString(w, `{"choices":[]}`)
+	}))
+	defer upstream.Close()
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/oa/v1/accounting":
+			_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+		case "/oa/v1/lease":
+			leases++
+			var request map[string]any
+			_ = json.NewDecoder(r.Body).Decode(&request)
+			if len(request) != 2 || request["call_id"] != trackedCall || request["request_limit_micro_usd"] != float64(1000000) {
+				t.Error("wrong wallet admission")
+			}
+			if leases > 1 {
+				w.WriteHeader(409)
+				_, _ = io.WriteString(w, `{"code":"call_id_reused"}`)
+				return
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"api_key": "tracked-private-key", "base_url": upstream.URL, "expires_at": time.Now().Unix() + 60, "verified": true, "verification_status": "verified", "accounting": testBinding()})
+		case "/wallet/status":
+			_, _ = io.WriteString(w, `{ "has_note": true, "pending_request": false }`)
+		case "/wallet/settle":
+			settlements++
+			_, _ = io.WriteString(w, `{"pending_request":false}`)
+		default:
+			t.Errorf("unexpected path %s", r.URL.Path)
+		}
+	}, upstream)
+	client.config.KeyReuseWindow = 5 * time.Minute
+	response, err := client.Complete(trackedContext(1001000), json.RawMessage(`{"model":"example/model"}`))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, _ = io.Copy(io.Discard, response.Body)
+	_ = response.Body.Close()
+	if client.cachedLease != nil || client.leaseGroup.until.After(client.now()) {
+		t.Fatal("tracked key retained")
+	}
+	if _, err = client.Complete(trackedContext(1001000), json.RawMessage(`{"model":"example/model"}`)); err == nil {
+		t.Fatal("reissued call accepted")
+	}
+	if calls != 1 || leases != 2 || settlements != 1 {
+		t.Fatalf("calls %d leases %d settlements %d", calls, leases, settlements)
+	}
+}
+func TestTrackedLeaseRejectsEveryBindingMismatchBeforeInference(t *testing.T) {
+	mutations := map[string]func(*CallBinding){"call": func(b *CallBinding) { b.CallID = "a0000000-0000-4000-8000-000000000002" }, "journal": func(b *CallBinding) { b.JournalID = strings.Repeat("c", 32) }, "session": func(b *CallBinding) { b.SessionID = "bad" }, "model cap": func(b *CallBinding) { b.RequestLimitMicroUSD = "2000000" }, "cap exceeds reservation": func(b *CallBinding) { b.CapUnits = "1000000" }, "feed": func(b *CallBinding) { b.BillingQuote.FeedAddress = "0x" + strings.Repeat("f", 40) }, "chain": func(b *CallBinding) { b.BillingQuote.ChainID = 11155111 }, "expired": func(b *CallBinding) { b.BillingQuote.UpdatedAt = 1; b.BillingQuote.ExpiresAt = 4501 }}
+	for name, mutate := range mutations {
+		t.Run(name, func(t *testing.T) {
+			calls := 0
+			upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls++ }))
+			defer upstream.Close()
+			client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/wallet/status" {
+					_, _ = io.WriteString(w, `{ "has_note": true, "pending_request": false }`)
+					return
+				}
+				if r.URL.Path == "/oa/v1/accounting" {
+					_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+					return
+				}
+				b := testBinding()
+				mutate(b)
+				_ = json.NewEncoder(w).Encode(map[string]any{"api_key": "one-use", "base_url": upstream.URL, "expires_at": time.Now().Unix() + 60, "verified": true, "verification_status": "verified", "accounting": b})
+			}, upstream)
+			if _, err := client.Complete(trackedContext(1001000), json.RawMessage(`{"model":"example/model"}`)); err == nil {
+				t.Fatal("unsafe accounting accepted")
+			}
+			if calls != 0 {
+				t.Fatal("provider called")
+			}
+		})
+	}
+}
+func TestTrackedPendingLeaseIsNeverRetried(t *testing.T) {
+	leases := 0
+	upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("provider called") }))
+	defer upstream.Close()
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/wallet/status" {
+			_, _ = io.WriteString(w, `{ "has_note": true, "pending_request": false }`)
+			return
+		}
+		if r.URL.Path == "/oa/v1/accounting" {
+			_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+			return
+		}
+		leases++
+		w.WriteHeader(409)
+		_, _ = io.WriteString(w, `{"code":"pending_settlement"}`)
+	}, upstream)
+	_, err := client.Complete(trackedContext(1001000), json.RawMessage(`{"model":"example/model"}`))
+	if err == nil || leases != 1 {
+		t.Fatalf("pending reissued: leases%d err%v", leases, err)
+	}
+}
+func TestSettlementSanitizesAndValidatesReceiptWithoutProviderDispatch(t *testing.T) {
+	for _, kind := range []string{"settled", "bound", "reserved", "bad charge", "bad identity", "bad receipt", "zero"} {
+		t.Run(kind, func(t *testing.T) {
+			upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { t.Error("provider called") }))
+			defer upstream.Close()
+			client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+				if r.URL.Path == "/wallet/status" {
+					_, _ = io.WriteString(w, `{ "has_note": true, "pending_request": false }`)
+					return
+				}
+				if r.URL.Path == "/oa/v1/accounting" {
+					_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+					return
+				}
+				report := CallSettlement{Version: 1, JournalID: trackedJournal, CallID: trackedCall, Status: "settled", Binding: testBinding(), Receipt: &CallReceipt{"0x" + strings.Repeat("c", 64), "10000", "1000000"}}
+				switch kind {
+				case "bound":
+					report.Status = "bound"
+					report.Receipt = nil
+				case "reserved":
+					report.Status = "reserved"
+					report.Binding = nil
+					report.Receipt = nil
+				case "bad charge":
+					report.Receipt.ChargeUnits = "333335"
+				case "bad identity":
+					report.JournalID = strings.Repeat("e", 32)
+				case "bad receipt":
+					report.Receipt.ReceiptID = "fake"
+				case "zero":
+					report.Receipt.ChargeUnits = "0"
+				}
+				raw, _ := json.Marshal(report)
+				var object map[string]any
+				_ = json.Unmarshal(raw, &object)
+				object["api_key"] = "never-return-this"
+				_ = json.NewEncoder(w).Encode(object)
+			}, upstream)
+			raw, err := client.CallSettlement(context.Background(), trackedCall)
+			if strings.HasPrefix(kind, "bad") {
+				if err == nil {
+					t.Fatal("invalid receipt accepted")
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if strings.Contains(string(raw), "api_key") || strings.Contains(string(raw), "never-return") {
+				t.Fatal("secret forwarded")
+			}
+		})
+	}
+}
+
+func TestTrackedWaitsForPriorSignedRecoveryBeforeOneLeaseAuthorization(t *testing.T) {
+	var reads, leases, retirements, calls int
+	upstream := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { calls++; _, _ = io.WriteString(w, `{"choices":[]}`) }))
+	defer upstream.Close()
+	client := newTestClient(t, func(w http.ResponseWriter, r *http.Request) {
+		switch r.URL.Path {
+		case "/oa/v1/accounting":
+			_ = json.NewEncoder(w).Encode(AccountingIdentity{1, trackedJournal})
+		case "/wallet/settle":
+			retirements++
+			w.WriteHeader(409)
+			_, _ = io.WriteString(w, `{"code":"pending_request"}`)
+		case "/wallet/status":
+			reads++
+			_ = json.NewEncoder(w).Encode(map[string]any{"has_note": true, "pending_request": reads < 3})
+		case "/oa/v1/lease":
+			leases++
+			if reads < 3 {
+				t.Error("lease authorized before settlement")
+			}
+			_ = json.NewEncoder(w).Encode(map[string]any{"api_key": "next-round-key", "base_url": upstream.URL, "expires_at": time.Now().Unix() + 60, "verified": true, "verification_status": "verified", "accounting": testBinding()})
+		default:
+			t.Errorf("unexpected path%s", r.URL.Path)
+		}
+	}, upstream)
+	client.leaseGroup = &leaseGroup{serial: 1, until: time.Now()}
+	client.keySerial = 1
