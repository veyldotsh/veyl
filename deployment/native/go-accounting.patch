diff --git a/zkapi-clientd/internal/zkapi/call_accounting.go b/zkapi-clientd/internal/zkapi/call_accounting.go
new file mode 100644
index 0000000..2289259
--- /dev/null
+++ b/zkapi-clientd/internal/zkapi/call_accounting.go
@@ -0,0 +1,247 @@
+package zkapi
+
+import (
+	"context"
+	"encoding/json"
+	"math/big"
+	"net/http"
+	"regexp"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/ethereum/zkapi/zkapi-clientd/internal/accounting"
+)
+
+type AccountingIdentity struct {
+	Version   int    `json:"version"`
+	JournalID string `json:"journal_id"`
+}
+type CallBinding struct {
+	Version              int            `json:"version"`
+	JournalID            string         `json:"journal_id"`
+	CallID               string         `json:"call_id"`
+	SessionID            string         `json:"session_id"`
+	RequestLimitMicroUSD string         `json:"request_limit_micro_usd"`
+	CapUnits             string         `json:"cap_units"`
+	BillingQuote         NativeUSDQuote `json:"billing_quote"`
+}
+type CallReceipt struct {
+	ReceiptID    string `json:"receipt_id"`
+	ChargeUnits  string `json:"charge_units"`
+	BalanceUnits string `json:"balance_units"`
+}
+type CallSettlement struct {
+	Version   int          `json:"version"`
+	JournalID string       `json:"journal_id"`
+	CallID    string       `json:"call_id"`
+	Status    string       `json:"status"`
+	Binding   *CallBinding `json:"binding,omitempty"`
+	Receipt   *CallReceipt `json:"receipt,omitempty"`
+}
+
+var digestPattern = regexp.MustCompile(`^[0-9a-f]{64}$`)
+
+func accountingError() error { return &Error{http.StatusBadGateway, "invalid_call_accounting"} }
+func decimalUnits(v string) (*big.Int, bool) {
+	if v == "0" {
+		return new(big.Int), true
+	}
+	return positiveDecimal(v, 128)
+}
+func (c *Client) Accounting(ctx context.Context) (json.RawMessage, error) {
+	if err := c.Check(ctx); err != nil {
+		return nil, err
+	}
+	raw, err := c.request(ctx, http.MethodGet, "/oa/v1/accounting", nil)
+	if err != nil {
+		return nil, err
+	}
+	var id AccountingIdentity
+	if json.Unmarshal(raw, &id) != nil || id.Version != 1 || !accounting.ValidJournalID(id.JournalID) {
+		return nil, accountingError()
+	}
+	return json.Marshal(id)
+}
+func (c *Client) validateBinding(b *CallBinding, callID, journalID string, fresh bool) error {
+	if b == nil || b.Version != 1 || b.CallID != callID || b.JournalID != journalID || !accounting.ValidCallID(b.CallID) || !accounting.ValidJournalID(b.JournalID) || !digestPattern.MatchString(b.SessionID) {
+		return accountingError()
+	}
+	cap, capOK := positiveDecimal(b.CapUnits, 128)
+	_, limitOK := positiveDecimal(b.RequestLimitMicroUSD, 64)
+	q := b.BillingQuote
+	_, manifest, err := pinnedDeployment(c.config.Network)
+	if err != nil {
+		return err
+	}
+	var pinned struct {
+		ChainID    uint64 `json:"chain_id"`
+		Feed       string `json:"native_price_feed_address"`
+		MaxAge     uint64 `json:"native_price_max_age_seconds"`
+		MinimumCap uint64 `json:"request_charge_cap"`
+	}
+	if json.Unmarshal(manifest, &pinned) != nil {
+		return accountingError()
+	}
+	_, roundOK := positiveDecimal(q.RoundID, 80)
+	answer, answerOK := positiveDecimal(q.Answer, 128)
+	now := uint64(c.now().Unix())
+	if !capOK || cap.Sign() == 0 || !limitOK || !roundOK || !answerOK || answer.Cmp(big.NewInt(1_000_000_000_000_000_000)) > 0 || q.Asset != "native_eth" || q.UnitsPerETH != 1_000_000_000 || q.ChainID != pinned.ChainID || q.FeedAddress != strings.ToLower(pinned.Feed) || q.Decimals != 8 || pinned.MaxAge == 0 || pinned.MaxAge > 86400 || q.UpdatedAt == 0 || q.UpdatedAt > now || q.ExpiresAt <= q.UpdatedAt || q.ExpiresAt-q.UpdatedAt != pinned.MaxAge || (fresh && q.ExpiresAt <= now) {
+		return accountingError()
+	}
+	limit, _ := new(big.Int).SetString(b.RequestLimitMicroUSD, 10)
+	numerator := new(big.Int).Mul(limit, big.NewInt(100_000_000_000_000_000))
+	denominator := new(big.Int).Mul(answer, big.NewInt(1_000_000))
+	numerator.Add(numerator, new(big.Int).Sub(denominator, big.NewInt(1)))
+	expected := numerator.Quo(numerator, denominator)
+	minimum := new(big.Int).SetUint64(pinned.MinimumCap)
+	if expected.Cmp(minimum) < 0 {
+		expected = minimum
+	}
+	if pinned.MinimumCap == 0 || cap.Cmp(expected) != 0 {
+		return accountingError()
+	}
+	return nil
+}
+func bindingValuation(b *CallBinding) *big.Int {
+	units, _ := new(big.Int).SetString(b.CapUnits, 10)
+	answer, _ := new(big.Int).SetString(b.BillingQuote.Answer, 10)
+	numerator := new(big.Int).Mul(units, answer)
+	numerator.Mul(numerator, big.NewInt(1_000_000))
+	denominator := big.NewInt(100_000_000_000_000_000)
+	numerator.Add(numerator, new(big.Int).Sub(denominator, big.NewInt(1)))
+	return numerator.Quo(numerator, denominator)
+}
+func (c *Client) CallSettlement(ctx context.Context, callID string) (json.RawMessage, error) {
+	if !accounting.ValidCallID(callID) {
+		return nil, accountingError()
+	}
+	identity, err := c.Accounting(ctx)
+	if err != nil {
+		return nil, err
+	}
+	var id AccountingIdentity
+	_ = json.Unmarshal(identity, &id)
+	raw, err := c.request(ctx, http.MethodGet, "/oa/v1/call-settlements/"+callID, nil)
+	if err != nil {
+		return nil, err
+	}
+	var result CallSettlement
+	if json.Unmarshal(raw, &result) != nil || result.Version != 1 || result.CallID != callID || result.JournalID != id.JournalID {
+		return nil, accountingError()
+	}
+	switch result.Status {
+	case "reserved":
+		if result.Binding != nil || result.Receipt != nil {
+			return nil, accountingError()
+		}
+	case "bound", "settled":
+		if err := c.validateBinding(result.Binding, callID, id.JournalID, false); err != nil {
+			return nil, err
+		}
+		if result.Status == "bound" {
+			if result.Receipt != nil {
+				return nil, accountingError()
+			}
+			break
+		}
+		r := result.Receipt
+		if r == nil || !strings.HasPrefix(r.ReceiptID, "0x") || !digestPattern.MatchString(strings.TrimPrefix(r.ReceiptID, "0x")) {
+			return nil, accountingError()
+		}
+		charge, ok := decimalUnits(r.ChargeUnits)
+		_, balanceOK := decimalUnits(r.BalanceUnits)
+		cap, _ := positiveDecimal(result.Binding.CapUnits, 128)
+		if !ok || !balanceOK || charge.Cmp(cap) > 0 {
+			return nil, accountingError()
+		}
+	default:
+		return nil, accountingError()
+	}
+	return json.Marshal(result)
+}
+func (c *Client) trackedLease(ctx context.Context, body json.RawMessage, admission accounting.Admission) (providerLease, error) {
+	if !admission.Valid() {
+		return providerLease{}, accountingError()
+	}
+	identity, err := c.Accounting(ctx)
+	if err != nil {
+		return providerLease{}, err
+	}
+	var id AccountingIdentity
+	_ = json.Unmarshal(identity, &id)
+	if id.JournalID != admission.JournalID {
+		return providerLease{}, accountingError()
+	}
+	// A tracked call owns one lease and cannot reuse an old provider credential.
+	c.cachedLease = nil
+	if c.leaseGroup != nil && !c.leaseGroup.attempted {
+		if err := c.settleGroup(ctx); err != nil && !isPendingSettlement(err) {
+			return providerLease{}, err
+		}
+	}
+	// The native service's background reconciler fetches signed settlement
+	// every five seconds. Poll only local readiness before assigning this ID to
+	// an issuance. Never repeat a retirement or a lease authorization here.
+	if err := c.waitTrackedReadiness(ctx); err != nil {
+		return providerLease{}, err
+	}
+	limit, err := c.requestBudget(ctx, body)
+	if err != nil {
+		return providerLease{}, err
+	}
+	if limit > admission.ReservedMicroUSD {
+		return providerLease{}, accountingError()
+	}
+	request, _ := json.Marshal(map[string]any{"request_limit_micro_usd": limit, "call_id": admission.CallID})
+	raw, err := c.request(ctx, http.MethodPost, "/oa/v1/lease", request)
+	// Issuance is one-shot. Even an explicit pending reply may have durably
+	// reserved this ID; only receipt lookup can resolve it, never a lease retry.
+	if err != nil {
+		return providerLease{}, err
+	}
+	lease, err := c.acceptLease(raw, limit)
+	if err != nil {
+		return providerLease{}, err
+	}
+	c.cachedLease = nil
+	c.leaseGroup.until = c.now()
+	if err := c.validateBinding(lease.Accounting, admission.CallID, admission.JournalID, true); err != nil {
+		return providerLease{}, err
+	}
+	if lease.Accounting.RequestLimitMicroUSD != strconv.FormatUint(limit, 10) || bindingValuation(lease.Accounting).Cmp(new(big.Int).SetUint64(admission.ReservedMicroUSD)) > 0 {
+		return providerLease{}, accountingError()
+	}
+	return lease, nil
+}
+
+func (c *Client) waitTrackedReadiness(ctx context.Context) error {
+	ctx, cancel := context.WithTimeout(ctx, 2*time.Minute)
+	defer cancel()
+	for {
+		raw, err := c.request(ctx, http.MethodGet, "/wallet/status", nil)
+		if err != nil {
+			return err
+		}
+		var wallet struct {
+			HasNote *bool `json:"has_note"`
+			Pending *bool `json:"pending_request"`
+		}
+		if json.Unmarshal(raw, &wallet) != nil || wallet.HasNote == nil || wallet.Pending == nil {
+			return accountingError()
+		}
+		if !*wallet.HasNote {
+			return &Error{http.StatusPaymentRequired, "funding_required"}
+		}
+		if !*wallet.Pending {
+			return nil
+		}
+		timer := time.NewTimer(c.settlementPoll)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return ctx.Err()
+		case <-timer.C:
+		}
+	}
+}
