+package server
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+)
+
+type diagnosticFixtureError struct{ code string }
+
+func (e diagnosticFixtureError) Error() string          { return "secret provider key and prompt" }
+func (e diagnosticFixtureError) DiagnosticCode() string { return e.code }
+
+func TestOnlyAllowlistedRuntimeDiagnosticCrossesHTTPBoundary(t *testing.T) {
+	for _, code := range []string{"verifier_response_rejected", "lease_reservation_failed", "secret-invalid-code"} {
+		backend := &fakeBackend{complete: func(context.Context, json.RawMessage) (*http.Response, error) {
+			return nil, diagnosticFixtureError{code}
+		}}
+		server := apiServer(t, backend)
+		response, err := http.DefaultClient.Do(request(t, server.URL, `{"model":"x","messages":[{"role":"user"}]}`))
+		if err != nil {
+			t.Fatal(err)
+		}
+		body, _ := io.ReadAll(response.Body)
+		response.Body.Close()
+		want := code
+		if strings.HasPrefix(code, "secret") {
+			want = "anonymous_access_failed"
+		}
+		if response.StatusCode != 502 || !strings.Contains(string(body), want) || strings.Contains(string(body), "secret") || strings.Contains(string(body), "prompt") {
+			t.Fatalf("unsafe diagnostic response %s", body)
+		}
+		if backend.calls.Load() != 1 {
+			t.Fatal("diagnostic caused retry")
+		}
+	}
+}
